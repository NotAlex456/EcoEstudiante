// Diseño de la base de datos de EcoEstudiante.
// Ver docs/superpowers/specs/2026-11-09-backend-design.md §3 y docs/backend-explicado.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  Venta
  Intercambio
  Donacion @map("Donación")
}

enum UserRole {
  student
  admin
}

enum CodePurpose {
  verify
  reset
}

enum ModerationAction {
  hide_material
  restore_material
  delete_material
  block_user
  unblock_user
  dismiss_report
}

enum Condition {
  ComoNuevo  @map("Como nuevo")
  BuenEstado @map("Buen estado")
  Usado
}

enum MaterialStatus {
  Disponible
  Reservado
  Entregado
  Pausado
  Eliminado
}

enum AgreementStatus {
  Pendiente
  Confirmado
  Completado
  Cancelado
}

enum BotJobKind {
  reply
  confirm_agreement
  buyer_interest
}

enum NotificationCategory {
  mensajes
  acuerdos
  busquedas
  cuenta
}

/// Estudiante real o simulado (isBot).
model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  career            String
  cycle             Int
  passwordHash      String
  verified          Boolean  @default(false)
  isBot             Boolean  @default(false)
  notificationPrefs Json     @default("{\"push\":true,\"quietNight\":false,\"categories\":{\"mensajes\":true,\"acuerdos\":true,\"busquedas\":true,\"cuenta\":true}}")
  /// student o admin (se asigna según ADMIN_EMAILS al ingresar).
  role              UserRole @default(student)
  /// Sube al cambiar la contraseña o al bloquear: invalida todas las sesiones anteriores.
  tokenVersion      Int      @default(0)
  /// Cuenta suspendida por un administrador.
  blockedAt         DateTime?
  createdAt         DateTime @default(now())

  emailCodes        EmailCode[]
  materials         Material[]
  savedMaterials    SavedMaterial[]
  savedSearches     SavedSearch[]
  reports           Report[]
  buyerChats        Conversation[] @relation("BuyerConversations")
  sellerChats       Conversation[] @relation("SellerConversations")
  messages          Message[]
  buyerAgreements   Agreement[]    @relation("BuyerAgreements")
  sellerAgreements  Agreement[]    @relation("SellerAgreements")
  reviewsWritten    Review[]       @relation("ReviewAuthor")
  reviewsReceived   Review[]       @relation("ReviewTarget")
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  uploads           Upload[]
  moderationLogs    ModerationLog[]
}

/// Código de verificación de correo (solo se guarda su hash).
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  /// verify (registro) o reset (recuperar contraseña): un código no sirve para lo otro.
  purpose   CodePurpose @default(verify)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Material {
  id          String         @id @default(cuid())
  ownerId     String
  title       String
  course      String
  career      String
  cycle       Int
  /// Texto libre normalizado (normalizeCategory).
  category    String
  mode        Mode
  price       Int            @default(0)
  exchangeFor String?
  condition   Condition
  description String
  status      MaterialStatus @default(Disponible)
  /// Ocultado por un administrador: el dueño no puede reactivarlo ni editarlo.
  moderatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        MaterialImage[]
  savedBy       SavedMaterial[]
  reports       Report[]
  conversations Conversation[]
  agreements    Agreement[]

  @@index([status, createdAt])
  @@index([ownerId])
  @@index([category])
}

model MaterialImage {
  id         String @id @default(cuid())
  materialId String
  url        String
  publicId   String
  position   Int

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model SavedMaterial {
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  category  String
  mode      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  materialId String
  userId     String
  reason     String
  detail     String
  createdAt  DateTime @default(now())
  /// Resuelto por un administrador: hidden (se ocultó la publicación) o dismissed (se descartó).
  resolvedAt DateTime?
  resolution String?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registro de cada acción de moderación (quién, qué, cuándo y por qué).
model ModerationLog {
  id        String           @id @default(cuid())
  adminId   String
  action    ModerationAction
  targetId  String
  reason    String?
  createdAt DateTime         @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// Chat entre el comprador y el vendedor de un material.
model Conversation {
  id            String    @id @default(cuid())
  materialId    String
  buyerId       String
  sellerId      String
  buyerReadAt   DateTime?
  sellerReadAt  DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  material Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([materialId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Acuerdo de entrega en un punto seguro del campus.
model Agreement {
  id         String          @id @default(cuid())
  materialId String
  buyerId    String
  sellerId   String
  place      String
  date       String
  time       String
  note       String?
  status     AgreementStatus @default(Pendiente)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  buyer    User     @relation("BuyerAgreements", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User     @relation("SellerAgreements", fields: [sellerId], references: [id], onDelete: Cascade)
  review   Review?

  @@index([materialId, status])
  @@index([buyerId])
  @@index([sellerId])
}

/// Reseña con estrellas. La reputación es el promedio de las reseñas recibidas.
model Review {
  id            String   @id @default(cuid())
  agreementId   String?  @unique
  authorId      String?
  authorName    String
  targetId      String
  stars         Int
  comment       String
  materialTitle String
  createdAt     DateTime @default(now())

  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  author    User?      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  target    User       @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  text      String
  link      String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Token FCM de un celular o navegador para enviarle push.
model DeviceToken {
  token     String   @id
  userId    String
  platform  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Foto subida con POST /uploads: registra quién la subió, para que nadie use (ni borre) fotos ajenas.
model Upload {
  url        String   @id
  uploaderId String
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
}

/// Acción programada de un estudiante simulado.
model BotJob {
  id        String     @id @default(cuid())
  kind      BotJobKind
  payload   Json
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([doneAt, dueAt])
}
