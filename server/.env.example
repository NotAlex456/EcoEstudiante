# --- Obligatorias ---
# Conexión a PostgreSQL. En local, "npm run db" levanta PostgreSQL embebido en el puerto 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecoestudiante
# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres, aleatoria.
JWT_SECRET=

# --- Servidor ---
# Puerto HTTP (por defecto 3000).
PORT=3000
# Orígenes que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost
# URL pública del servidor (para las fotos en modo local).
PUBLIC_URL=http://localhost:3000
# Peticiones por minuto y por IP permitidas en /api/auth.
AUTH_RATE_LIMIT=10

# --- Correo (si no hay ninguno, el código se imprime en la consola) ---
# Opción recomendada en Render (bloquea SMTP en el plan gratuito): Brevo, API HTTP (https://www.brevo.com)
BREVO_API_KEY=
# Opción 1: Resend (https://resend.com)
RESEND_API_KEY=
# Opción 2: Gmail SMTP con contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente de los correos.
MAIL_FROM="EcoEstudiante <no-reply@ecoestudiante.app>"

# --- Fotos (si falta, se guardan en server/uploads/) ---
CLOUDINARY_URL=
# Carpeta de las fotos en modo local (por defecto server/uploads).
UPLOADS_DIR=

# --- Push (si falta, no se envían notificaciones push) ---
# JSON de la cuenta de servicio de Firebase, codificado en base64.
FIREBASE_SERVICE_ACCOUNT=

# --- Estudiantes simulados ---
BOTS_ENABLED=true

# --- Acceso ---
# Correos no institucionales que igual pueden registrarse (separados por coma).
ALLOWED_EMAILS=
# Correos que reciben el rol de administrador al ingresar (panel en /admin).
ADMIN_EMAILS=
